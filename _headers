# ==========================================================
# Netlify / Cloudflare Pages — cache headers
# (compression is automatic on both platforms)
# ==========================================================

# Big binary assets never change (regenerate the filename if you re-export):
# cache them hard for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/js/draco/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=2592000

# HTML must always revalidate so new deploys appear immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
